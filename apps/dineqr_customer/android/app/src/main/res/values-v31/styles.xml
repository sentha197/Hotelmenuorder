<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ system splash: the same white DineQR symbol (120dp in a
         288dp icon canvas) on the ember background, so it hands over to the
         identical first frame of the Flutter splash. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/dineqr_launch_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
</resources>
