<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ system splash: the plain ember background (its icon is
         empty), like the first frame of the Flutter splash, which then draws
         the DineQR logo from nothing. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/dineqr_launch_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_blank</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
</resources>
