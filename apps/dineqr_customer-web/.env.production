# `npm run build`: the deployed DineQR API (Render), as the Flutter release
# builds use. Its CORS list (Cors__AllowedOrigins) must include the origin
# this site is served from. Override per host with a VITE_API_URL variable
# in the build environment; an empty value means "same origin" (the host
# proxies /api and /hubs to the API).
VITE_API_URL=https://hotelmenuorder.onrender.com
