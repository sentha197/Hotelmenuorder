# `npm run dev`: the API started locally with `dotnet run` (port 5264), as
# the Flutter debug builds use. Its Development CORS policy allows any
# localhost origin, so the dev server can call it directly.
VITE_API_URL=http://localhost:5264

# In-app demo QR codes on the scanner (dev only; never in production).
VITE_DEMO_QR_CODES=true
