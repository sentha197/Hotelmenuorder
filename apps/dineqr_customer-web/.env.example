# Public build-time settings. Everything here ends up in the browser bundle:
# never put secrets, keys or credentials in VITE_ variables.

# The DineQR API host (without /api/v1). Empty = same origin as the site.
VITE_API_URL=https://hotelmenuorder.onrender.com

# Extra origins whose table QR links this app accepts when scanned in-app,
# comma separated (the site's own origin is always accepted). Use it when
# codes were printed for another domain that also serves this app.
VITE_QR_ORIGINS=
