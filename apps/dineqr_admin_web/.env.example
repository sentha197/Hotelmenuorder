# Public build-time settings. Everything here ends up in the browser bundle:
# never put secrets, keys or credentials in VITE_ variables.

# The DineQR API host (without /api/v1). Empty = same origin as the site
# (the host proxies /api and /hubs to the API).
VITE_API_URL=https://hotelmenuorder.onrender.com

# Where the DineQR customer web app is served. When set, printed table QR
# codes are links to it (https://<site>/t/05, /takeaway); unset, a production
# build on the deployed API uses that API's host, and other builds print the
# plain DINEQR:TABLE:05 payloads (the same rule as the Flutter apps'
# DINEQR_WEB_URL).
VITE_DINEQR_WEB_URL=

# Optional Google Maps JavaScript API key for the map in Settings > GPS
# ordering area. Without it, the restaurant's location is entered as
# coordinates (or taken from this device), as in the Flutter app. Restrict
# the key to this site's origin in the Google Cloud console.
VITE_GOOGLE_MAPS_API_KEY=
