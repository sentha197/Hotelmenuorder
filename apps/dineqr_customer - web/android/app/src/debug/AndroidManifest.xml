<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Cleartext http:// to a local DineQR API is allowed here through the
         dineqrCleartext manifest placeholder (app/build.gradle.kts), which
         the debug build type sets to true. Release builds require HTTPS
         unless they opt in explicitly. -->
</manifest>
