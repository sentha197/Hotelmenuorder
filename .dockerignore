# Build context for the API image (Dockerfile at the repository root). Only
# backend/src/DineQR.Api is published. Local build output must stay out: a
# Windows obj/ copied over the restored one breaks `publish --no-restore`.
**/bin
**/obj
**/.vs
**/*.user
.git
.vscode
.idea
apps
# The customer web app is built into the image (served by the API); only its
# sources go in, never a Windows node_modules or a local build.
!apps/dineqr_customer-web
apps/dineqr_customer-web/node_modules
apps/dineqr_customer-web/dist
apps/dineqr_customer-web/dist-preview
apps/dineqr_customer-web/e2e
packages
android
ios
docs
branding
backend/tests
backend/src/DineQR.Api/wwwroot/uploads

# Secrets and backups never go into an image.
**/.env
**/*.env.local
**/*.dump
