# DineQR API settings, as environment variables (placeholders only).
#
# For local development prefer .NET user secrets (stored outside the repo):
#   cd backend/src/DineQR.Api
#   dotnet user-secrets set "ConnectionStrings:DefaultConnection" "Host=localhost;Port=5432;Database=dineqr;Username=postgres;Password=<password>"
#   dotnet user-secrets set "Jwt:SigningKey" "<at least 32 random bytes, e.g. base64 of 48 random bytes>"
#   dotnet user-secrets set "Bootstrap:OwnerEmail" "<first owner email>"
#   dotnet user-secrets set "Bootstrap:OwnerPassword" "<first owner password>"
#
# In production set the same keys as environment variables (double
# underscore = section separator). Never commit real values.

ASPNETCORE_ENVIRONMENT=Production
# Outside Docker only. The Docker image (root Dockerfile, used on Render)
# already listens on port 10000 and trusts the proxy's X-Forwarded-* headers;
# setting ASPNETCORE_URLS there would move it off the port Render expects.
ASPNETCORE_URLS=http://0.0.0.0:5264
# ASPNETCORE_FORWARDEDHEADERS_ENABLED=true   # behind any HTTPS reverse proxy

ConnectionStrings__DefaultConnection=Host=<db-host>;Port=5432;Database=dineqr;Username=<db-user>;Password=<db-password>
Jwt__SigningKey=<at-least-32-random-bytes>
Jwt__AccessTokenMinutes=15
Jwt__SessionHours=8
Jwt__GuestSessionHours=4

# Creates the first owner account when no active owner exists (remove after).
Bootstrap__OwnerEmail=<owner-email>
Bootstrap__OwnerPassword=<strong-password>
Bootstrap__OwnerName=Restaurant Owner

# Apply EF Core migrations at start-up (or run `dotnet ef database update`).
Database__MigrateOnStartup=false

# Import Data/Seed/initial-catalog.json into EMPTY tables only (first run).
Seed__InitialCatalog=false
Seed__UtcOffsetMinutes=330

# Online payment provider: None (counter payments only) until a real
# provider is integrated. "Simulated" is refused outside Development.
Payments__Provider=None

# Absolute https base for uploaded dish photo URLs (the API's public address).
ImageStorage__PublicBaseUrl=https://<api-host>

# Browser (Flutter web) origins allowed to call the API.
Cors__AllowedOrigins__0=https://<customer-web-host>
Cors__AllowedOrigins__1=https://<admin-web-host>

# Swagger UI outside Development (keep false on public servers).
OpenApi__Enabled=false
