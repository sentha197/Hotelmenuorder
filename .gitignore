# DineQR workspace: two Flutter apps (apps/) and two shared packages
# (packages/). Each project also has its own .gitignore.

# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# Flutter/Dart/Pub related (in every project folder)
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
build/
coverage/

# Kotlin daemon session files
.kotlin/

# Symbolication / obfuscation
app.*.symbols
app.*.map.json

# JVM crash logs
hs_err_pid*.log

# .NET backend (backend/)
**/bin/
**/obj/
.vs/
*.user
TestResults/

# Local secrets and database backups never go in the repository
# (backend/.env.example lists the settings, with placeholders).
.env
*.env.local
*.dump
